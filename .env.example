DATABASE_URL=your_database_url_here
WEBHOOK_URL=your_discord_webhook_url_here
FORM_ID=your_google_form_id_here

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Cloudflare R2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket_name
R2_PUBLIC_URL=https://your-r2-public-url.com

# YouTube Data API v3 (optional — oEmbed fallback works without it)
YOUTUBE_API_KEY=

# GitHub REST API (optional — raises the anonymous rate limit from 60 to 5000 req/h)
GITHUB_TOKEN=

# Contact form email (Purelymail): every message is emailed to CONTACT_TO, and
# the sender gets a confirmation. Without these, messages only reach the
# Discord webhook / Google Form above. User is the full address, password is
# that mailbox's password (or an app password).
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_USER=me@doncez.art
SMTP_PASS=
MAIL_FROM="DONCEZART <me@doncez.art>"
# Where contact form messages are emailed (default me@doncez.art).
CONTACT_TO=
